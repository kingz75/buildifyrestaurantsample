{
  "rules": {
    ".read": false,
    ".write": false,
    "categories": {
      ".read": true,
      ".write": "auth != null && root.child('staffMembers').child(auth.uid).child('active').val() === true"
    },
    "menu": {
      ".read": true,
      ".write": "auth != null && root.child('staffMembers').child(auth.uid).child('active').val() === true"
    },
    "orders": {
      ".read": true,
      ".write": true,
      ".indexOn": ["accessCode", "table", "timestamp"],
      "$orderId": {
        ".read": true,
        ".write": true
      }
    },
    "settings": {
      "billing": {
        ".read": true,
        ".write": "auth != null && root.child('staffMembers').child(auth.uid).child('active').val() === true"
      },
      "onlineCharges": {
        ".read": true,
        ".write": "auth != null && root.child('staffMembers').child(auth.uid).child('active').val() === true"
      },
      "itemTags": {
        ".read": "auth != null && root.child('staffMembers').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('staffMembers').child(auth.uid).child('active').val() === true"
      },
      "$other": {
        ".read": false,
        ".write": false
      }
    },
    "staffMembers": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "tables": {
      ".read": "auth != null && root.child('staffMembers').child(auth.uid).child('active').val() === true",
      ".write": "auth != null && root.child('staffMembers').child(auth.uid).child('active').val() === true"
    }
  }
}
